{
  "name": "@fantasia/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fantasia/web dev",
    "story:build": "node apps/story-studio/build.mjs",
    "assets:verify": "node scripts/runtime-assets.mjs",
    "assets:publish": "node scripts/runtime-assets.mjs --publish",
    "backend:acceptance": "node scripts/backend-acceptance.mjs",
    "backend:acceptance:self-test": "node scripts/backend-acceptance.mjs --self-test",
    "check": "pnpm check:format && pnpm check:architecture && pnpm check:determinism && pnpm check:content-studio-deployment && pnpm check:studio-registry && pnpm check:studio-auth && pnpm check:studio-read-model && pnpm check:studio-canonical-change && pnpm assets:verify && pnpm backend:acceptance:self-test",
    "check:write": "biome check --write .",
    "check:format": "biome check . --max-diagnostics=100",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:content-studio-deployment": "node scripts/check-content-studio-deployment.mjs",
    "check:studio-registry": "node scripts/check-studio-registry.mjs",
    "check:studio-auth": "node scripts/check-studio-auth.mjs",
    "check:studio-read-model": "node scripts/check-studio-read-model.mjs",
    "check:studio-canonical-change": "node scripts/check-studio-canonical-change.mjs",
    "foundation:consumer": "node packages/runtime/scripts/check-foundation-consumer.mjs",
    "shared:prepare": "node scripts/prepare-shared-packages.mjs",
    "shared:verify": "node scripts/verify-shared-packages.mjs",
    "shared:consumer": "node scripts/check-shared-consumer.mjs",
    "audit": "pnpm audit --audit-level moderate",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:content-studio": "playwright test --config=playwright.content-studio.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "build": "pnpm -r build && pnpm story:build",
    "verify": "pnpm audit && pnpm foundation:consumer && pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm test:content-studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
